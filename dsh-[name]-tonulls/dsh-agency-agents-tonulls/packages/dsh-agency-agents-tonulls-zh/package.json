{
  "name": "dsh-agency-agents-tonulls-zh",
  "description": "面向 DSH 的 Agency Agents 套件，提供简体中文控制消息",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./provider": "./src/provider.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "src/*.js",
    "assets/agents/**/*.md",
    "assets/agents/catalog.json",
    "UPSTREAM.json",
    "cordis.patch.yml",
    "LICENSES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-skill": "*"
  }
}
